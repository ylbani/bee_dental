# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase / PostgreSQL Database Connection (Pooling & Direct)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bee_dental?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bee_dental?schema=public"

# Supabase Auth & Storage (Client & Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Integrations & API Keys
INTEGRATION_API_KEY_SECRET="bee-dental-super-secret-hash-key-change-in-production"
CRON_SECRET="bee-dental-cron-secret-change-in-production"

# WhatsApp Business Cloud API (Optional / Adapter)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="bee_dental_webhook_token"

